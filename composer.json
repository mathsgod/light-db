{
    "name": "mathsgod/light-db",
    "description": "A convention-based Active Record layer built on light-entity",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Raymond Chong",
            "email": "mathsgod@yahoo.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "mathsgod/light-entity": "dev-main",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Light\\Db\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Light\\Db\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test:mysql": "bash scripts/test-mysql.sh",
        "analyse": "phpstan analyse src --level=5 --no-progress"
    }
}
